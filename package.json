{
  "name": "htn-solana",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:server": "bun run --filter '@htn/server' dev",
    "dev:pwa": "bun run --filter '@htn/pwa' dev",
    "build": "bun run --filter '*' build",
    "test": "bun test",
    "test:e2e": "bun test apps/server/test/e2e.test.ts",
    "typecheck": "bun run --filter '*' typecheck",
    "program:build": "./scripts/build-program.sh",
    "program:test": "cd program && cargo test",
    "localnet": "./scripts/localnet.sh start",
    "localnet:stop": "./scripts/localnet.sh stop",
    "localnet:env": "./scripts/localnet.sh env"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@solana/web3.js": "^1.98.4",
    "bs58": "^6.0.0"
  }
}
