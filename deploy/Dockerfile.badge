FROM litestream/litestream:0.3.13 AS litestream
FROM oven/bun:1-alpine
WORKDIR /app
COPY package.json bun.lock ./
COPY apps/server/package.json apps/server/package.json
COPY apps/pwa/package.json apps/pwa/package.json
COPY apps/badge-service/package.json apps/badge-service/package.json
COPY packages/chain/package.json packages/chain/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY starter/package.json starter/package.json
RUN bun install --frozen-lockfile
COPY . .
COPY --from=litestream /usr/local/bin/litestream /usr/local/bin/litestream
COPY deploy/litestream-badge.yml /etc/litestream.yml
COPY deploy/entrypoint-badge.sh /usr/local/bin/entrypoint.sh
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
