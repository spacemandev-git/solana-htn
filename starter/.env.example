WALLET_ADDRESS=            # where the agent's USDC lands (payTo) — REQUIRED
PROGRAM_ID=                # your deployed htn_quest program — REQUIRED
PRICE_USD=1.00             # what you charge; the agent pays at most $1
SOLANA_CLUSTER=devnet      # devnet | mainnet
SOLANA_RPC_URL=            # optional, defaults to the cluster public RPC
FACILITATOR_URL=https://facilitator.payai.network
KEYPAIR_PATH=~/.config/solana/id.json   # used by set-message only
PORT=4021
