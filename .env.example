# Copy to .env and adjust. Every value has a working local default, so an empty
# .env still boots the badge -> beacon -> phone loop (with simulated payments).

# --- server ---------------------------------------------------------------
PORT=3000
NODE_ENV=development
# ':memory:' is honoured verbatim, which is what the tests use.
DATABASE_PATH=./data/htn.db

# The two `box` ids the Solana relays send. The first hands out item 8 at once;
# the final box hands out item 9 only after the badge completes the quest. The
# full box table lives in packages/shared/src/items.ts.
SOLANA_BOX_ID=solana-booth
SOLANA_FINAL_BOX_ID=solana-booth-final

# Origin allowed through CORS, and the base of the pairing link returned to badges.
PWA_ORIGIN=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173

# --- PWA build ------------------------------------------------------------
VITE_BADGE_API_BASE=http://localhost:3100

# --- badge service (run separately from the API) --------------------------
# These duplicate PORT and DATABASE_PATH deliberately: use them in the
# apps/badge-service process environment, not alongside the API values above.
# PORT=3100
# DATABASE_PATH=./data/badge.db
# CORS_ORIGINS=http://localhost:5173
# PUBLIC_URL=http://localhost:3100
# ADMIN_TOKEN=

# --- quest / x402 ---------------------------------------------------------
# Which cluster the quest runs against: devnet or mainnet.
SOLANA_CLUSTER=devnet

# Leave X402_PAYER_SECRET_KEY unset to run with payments disabled: the whole
# loop still works, the payment step is simulated, and /api/health reports
# chainEnabled:false. Set it to a base58-encoded 64-byte secret key whose
# wallet holds the payment token (and a little SOL) on the chosen cluster.
# X402_PAYER_SECRET_KEY=

# Defaults to the cluster's public RPC when unset.
# SOLANA_RPC_URL=https://api.devnet.solana.com

# The reward ceiling per badge, in whole payment tokens. 1 means 1.00 HTN on
# devnet and $1 USDC on mainnet. The agent never pays a badge twice.
MAX_REWARD_USD=1

# Optional payment-token overrides; both default by cluster. Devnet uses HTN
# Bucks / HTN, while mainnet uses USDC / USDC.
# PAYMENT_MINT=
# PAYMENT_SYMBOL=
