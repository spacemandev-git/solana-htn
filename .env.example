# Copy to .env and adjust. Every value has a working local default, so an empty
# .env still boots the badge -> station -> phone loop (without a chain).

# --- server ---------------------------------------------------------------
PORT=3000
NODE_ENV=development
# ':memory:' is honoured verbatim, which is what the tests use.
DATABASE_PATH=./data/htn.db

# Shared secret the Sync Stations authenticate with (x-station-key header).
# CHANGE THIS before pointing real hardware at the server.
STATION_API_KEY=dev-station-key

# Origin allowed through CORS, and the base of the pairing URL handed to stations.
PWA_ORIGIN=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173

# --- solana ---------------------------------------------------------------
# Leave SOLANA_RPC_URL and SOLANA_AUTHORITY_SECRET_KEY unset to run with the
# disabled chain client: everything still works, nothing is written on chain,
# and /api/health reports chainEnabled:false.
#
# `bun run localnet` starts a validator, deploys the program, and prints all
# three of these ready to paste.
PROGRAM_ID=6kdZgrhS4FANagxKHiMoJzm2wEp2NRgNYTkjpYYRjtdD
# SOLANA_RPC_URL=http://127.0.0.1:8899
# base58-encoded 64-byte secret key for the registry authority (the mint key).
# SOLANA_AUTHORITY_SECRET_KEY=
