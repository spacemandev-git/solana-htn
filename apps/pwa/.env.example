# Base URL for the badge API. Leave empty in dev: vite proxies /api -> localhost:3000.
# In production set it to the origin serving the API, e.g. https://badges.example.com
VITE_API_BASE=

# Only needed for wallets that sign but cannot send transactions. Defaults to the
# public RPC for the account's cluster (devnet/testnet/mainnet/localnet).
VITE_SOLANA_RPC_URL=
